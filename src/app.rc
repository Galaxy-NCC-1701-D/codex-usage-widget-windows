#include <windows.h>
#include "version.h"
1 RT_MANIFEST "app.manifest"
1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION UW_VERSION_RESOURCE
PRODUCTVERSION UW_VERSION_RESOURCE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Usage Widget\0"
   VALUE "ProductName", "Usage Widget\0"
   VALUE "FileVersion", UW_VERSION "\0"
   VALUE "OriginalFilename", "UsageWidget.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

201 WAVE "sounds/reset-chime.wav"
